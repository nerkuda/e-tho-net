{
  "name": "ddcb8e84-p1p2p1-pending",
  "description": "Задача ddcb8e84, вариант «медленный PUT / last-write-wins»: в панели «Свойства» P1 набрано «окно» без Enter (pending-коммит bfe1bc24). Уход на P2 запускает фиксацию набранного; PUT идёт через прокси с задержкой ОТПРАВКИ 5 с. Пока он висит, прямой REST («второй клиент») пишет в P1 «срочно, смена» (сервер сразу видит её). Возврат на P1: панель обязана показать серверное состояние; через ~5 с приходит отложенный PUT и перезаписывает внешнюю правку (last-write-wins: набранное до правки доставлено после). Сценарий фиксирует эту последовательность и проверяет, что панель сходится к фактическому серверному значению, а не остаётся на снимке. Запуск: node client/scripts/ui-probe-stand.mjs --scenario client/scripts/ui-probe.ddcb8e84-p1p2p1-pending.scenario.json --scenario-seed client/scripts/ui-probe.ddcb8e84-p1p2p1-seed.mjs --delay-seed-rule '5000:properties/Tags-ddcb8e84' --out .tmp/etn-ddcb8e84/out-pending",
  "timeout": 300000,
  "steps": [
    { "name": "onboarding-visible", "waitFor": "document.querySelector(\"input[placeholder^='http']\") !== null" },
    { "name": "fill-server-url", "click": "input[placeholder^='http']" },
    { "name": "server-url-typed", "text": "{{serverUrl}}" },
    { "name": "fill-api-key", "click": "input[type=password]" },
    { "name": "api-key-typed", "text": "{{apiKey}}" },
    { "name": "connect", "click": ".onboarding-card .ui-btn--primary" },
    { "name": "networks-visible", "waitFor": "document.querySelectorAll('.network-item').length > 0" },
    { "name": "open-network", "click": ".networks-list .network-item" },

    {
      "name": "clouds-both",
      "waitFor": "(() => { const p1=document.querySelector('.cloud[data-id=\"{{thoughtId}}\"]'); const p2=[...document.querySelectorAll('.cloud')].find((n)=>n.textContent.includes('Person 2 ddcb8e84')); if(!p1 || !p2) return false; window.__p2=p2.getAttribute('data-id'); return typeof window.__p2 === 'string' && window.__p2 !== ''; })()",
      "timeout": 20000
    },

    { "name": "open-p1", "probe": "(() => { const c=document.querySelector('.cloud[data-id=\"{{thoughtId}}\"]'); if(!c) return 'no-cloud'; c.click(); return 'ok'; })()", "expect": "ok" },
    { "name": "p1-opened", "waitFor": "document.querySelector('.editor-title-input')?.value === 'Проба стенда'", "timeout": 20000 },
    { "name": "open-properties-tab", "probe": "(() => { const tab=[...document.querySelectorAll('.editor-tab')].find((b)=>b.textContent.includes('Свойства')); if(!tab) return 'no-tab'; tab.click(); return 'ok'; })()", "expect": "ok" },
    { "name": "chip-serious", "waitFor": "[...document.querySelectorAll('.properties-type-body .value-chips-field .prc-title')].some((n)=>n.textContent==='срочно')", "timeout": 20000 },

    { "name": "type-pending", "probe": "(() => { const i=document.querySelector('.properties-type-body .value-chips-input'); if(!i) return 'no-input'; window.__pendingField=i; i.setAttribute('data-probe','pending'); i.value='окно'; i.dispatchEvent(new Event('input')); return i.value === 'окно' ? 'ok' : 'bad'; })()", "expect": "ok" },

    { "name": "open-p2", "probe": "(() => { const c=document.querySelector('.cloud[data-id=\"'+window.__p2+'\"]'); if(!c) return 'no-cloud'; c.click(); return 'ok'; })()", "expect": "ok" },
    { "name": "p2-opened", "waitFor": "document.querySelector('.editor-title-input')?.value === 'Person 2 ddcb8e84'", "timeout": 20000 },
    { "name": "p2-panel", "waitFor": "[...document.querySelectorAll('.properties-type-body .value-chips-field .prc-title')].some((n)=>n.textContent==='прочее')", "timeout": 20000 },

    {
      "name": "external-write-tags",
      "api": { "name": "external-write-tags", "method": "PUT", "path": "/networks/{{networkId}}/thoughts/{{thoughtId}}/properties/Tags-ddcb8e84", "body": { "value": "срочно, смена" }, "expression": "data.value" },
      "expect": "срочно, смена"
    },
    { "name": "realtime-settled", "probe": "(async () => { await new Promise((r)=>setTimeout(r,600)); return 'ок'; })()", "expect": "ок" },
    {
      "name": "server-after-external",
      "api": { "name": "server-after-external", "method": "GET", "path": "/networks/{{networkId}}/thoughts/{{thoughtId}}/properties", "expression": "(() => { const tags=data.find((v)=>v.property_name==='Tags-ddcb8e84'); return tags ? tags.value : 'null'; })()" },
      "expect": "срочно, смена"
    },

    { "name": "return-p1", "probe": "(() => { const c=document.querySelector('.cloud[data-id=\"{{thoughtId}}\"]'); if(!c) return 'no-cloud'; c.click(); return 'ok'; })()", "expect": "ok" },
    { "name": "p1-returned", "waitFor": "document.querySelector('.editor-title-input')?.value === 'Проба стенда'", "timeout": 20000 },

    { "name": "put-settled", "probe": "(async () => { await new Promise((r)=>setTimeout(r,6500)); return 'ок'; })()", "expect": "ок" },
    {
      "name": "server-after-pending-put",
      "api": { "name": "server-after-pending-put", "method": "GET", "path": "/networks/{{networkId}}/thoughts/{{thoughtId}}/properties", "expression": "(() => { const tags=data.find((v)=>v.property_name==='Tags-ddcb8e84'); return tags ? tags.value : 'null'; })()" },
      "expect": "срочно, окно"
    },
    { "name": "panel-shows-okno", "waitFor": "[...document.querySelectorAll('.properties-type-body .value-chips-field .prc-title')].some((n)=>n.textContent==='окно')", "timeout": 20000 },
    { "name": "panel-values-final", "probe": "(() => { const chips=[...document.querySelectorAll('.properties-type-body .value-chips-field .prc-title')].map((n)=>n.textContent); return chips.join('|'); })()", "expect": "срочно|окно" }
  ]
}
