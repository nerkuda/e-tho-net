{
  "name": "chronicle-title-wiki-links",
  "description": "Ключевой сценарий ошибки 6b4e402a: заголовок карточки дневниковой ленты резолвит ID-форму wiki-ссылки в имя мысли, а не показывает сырой [[#<uuid>]]. Данные засеиваются шагом api: дневниковая запись БЕЗ title с телом, начинающимся с [[#<id>]] (id — засеянная мысль «Проба стенда»). До фикса заголовок карточки показывал сырой код. Запускается стендом: node client/scripts/ui-probe-stand.mjs --scenario client/scripts/ui-probe.chronicle-title-wiki-links.scenario.json. Без скриншотов: доказательства — пробы textContent заголовка (.diary-record-title) и контроль по БД.",
  "timeout": 120000,
  "steps": [
    {
      "name": "onboarding-visible",
      "waitFor": "document.querySelector(\"input[placeholder^='http']\") !== null"
    },
    { "name": "fill-server-url", "click": "input[placeholder^='http']" },
    { "name": "server-url-typed", "text": "{{serverUrl}}" },
    { "name": "fill-api-key", "click": "input[type=password]" },
    { "name": "api-key-typed", "text": "{{apiKey}}" },
    { "name": "connect", "click": ".onboarding-card .ui-btn--primary" },
    {
      "name": "networks-visible",
      "waitFor": "document.querySelectorAll('.network-item').length > 0"
    },
    { "name": "open-network", "click": ".networks-list .network-item" },
    {
      "name": "seeded-cloud-visible",
      "waitFor": "document.querySelector('[data-id=\"{{thoughtId}}\"]') !== null"
    },

    {
      "name": "seed-diary-record-no-title",
      "api": {
        "name": "seed-diary-record-no-title",
        "method": "POST",
        "path": "/networks/{{networkId}}/thoughts/{{thoughtId}}/comments",
        "body": {
          "kind": "chronological",
          "body_md": "[[#{{thoughtId}}]] zzqlinkfeed остальной текст записи"
        },
        "expression": "data.id ?? null"
      }
    },
    {
      "name": "record-seeded-in-db",
      "api": {
        "name": "record-seeded-in-db",
        "method": "GET",
        "path": "/networks/{{networkId}}/thoughts/{{thoughtId}}/comments",
        "expression": "data.filter((c) => c.kind === 'chronological' && (c.body_md || '').includes('zzqlinkfeed')).length"
      },
      "expect": 1
    },

    { "name": "open-diary", "click": ".view-tab[title=\"Дневник\"]" },
    {
      "name": "diary-record-visible",
      "waitFor": {
        "expression": "document.querySelector('.diary-record-title') !== null"
      }
    },
    {
      "name": "diary-title-text",
      "probe": {
        "name": "diaryTitleText",
        "expression": "[...document.querySelectorAll('.diary-record-title')].map(e => e.textContent).join(' | ')"
      }
    },
    {
      "name": "diary-title-no-raw",
      "probe": {
        "name": "diaryTitleHasRaw",
        "expression": "[...document.querySelectorAll('.diary-record-title')].some(e => (e.textContent || '').includes('[[#'))"
      },
      "expect": false
    },
    {
      "name": "diary-title-no-uuid",
      "probe": {
        "name": "diaryTitleHasUuid",
        "expression": "[...document.querySelectorAll('.diary-record-title')].some(e => /[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}/.test(e.textContent || ''))"
      },
      "expect": false
    },
    {
      "name": "diary-title-shows-name",
      "probe": {
        "name": "diaryTitleShowsName",
        "expression": "[...document.querySelectorAll('.diary-record-title')].some(e => (e.textContent || '').includes('{{seedTitle}}'))"
      },
      "expect": true
    }
  ]
}
