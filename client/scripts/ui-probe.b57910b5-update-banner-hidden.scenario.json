{
  "name": "b57910b5-update-banner-hidden",
  "description": "Баннер рекомендованной версии НЕ показывается при compatible (элемент ed068706, задача b57910b5). Стенд поднимается БЕЗ ETN_RECOMMENDED_CLIENT_VERSION: сервер 0.15.1 рекомендует сам себя, вердикт compatible. После подключения и открытия сети рабочее пространство на месте, а полосы .update-banner нет. Без скриншотов: доказательства — текстовые пробы DOM.",
  "timeout": 90000,
  "steps": [
    {
      "name": "onboarding-visible",
      "waitFor": "document.querySelector(\"input[placeholder^='http']\") !== null"
    },
    { "name": "fill-server-url", "click": "input[placeholder^='http']" },
    { "name": "server-url-typed", "text": "{{serverUrl}}" },
    { "name": "fill-api-key", "click": "input[type=password]" },
    { "name": "api-key-typed", "text": "{{apiKey}}" },
    { "name": "connect", "click": ".onboarding-card .ui-btn--primary" },
    {
      "name": "networks-visible",
      "waitFor": "document.querySelectorAll('.network-item').length > 0"
    },
    { "name": "open-network", "click": ".networks-list .network-item" },
    {
      "name": "workspace-visible",
      "waitFor": "document.querySelector('.workspace') !== null"
    },
    {
      "name": "seeded-cloud-visible",
      "waitFor": "document.querySelector('[data-id=\"{{thoughtId}}\"]') !== null"
    },
    {
      "name": "no-update-banner",
      "probe": "document.querySelector('.update-banner') === null",
      "expect": true
    },
    {
      "name": "no-blocking-dialog",
      "probe": "document.querySelector('.dialog-backdrop') === null",
      "expect": true
    }
  ]
}
