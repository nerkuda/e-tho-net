{
  "name": "f8f8fa49-link-target-type-restriction",
  "description": "Ключевой GUI-сценарий ошибки f8f8fa49: пикер целей свойства-связи ограничен типами ПРОТИВОПОЛОЖНОГО КОНЦА привязок (не config.allowed_*). Пример заказчика: свойство «Место работы» с привязкой source к типу «Персона» и target к типу «Организация». В массовом диалоге, типовых и внетиповых строках карточки прямое имя предлагает организации, обратное имя «Сотрудники» — персоны; «Кандидат без типа» не предлагается при любом ограничении. Самодостаточно: онтология и мысли заводятся probe-шагом через window.etn до открытия сети. Запуск: node client/scripts/ui-probe-stand.mjs --scenario client/scripts/ui-probe.f8f8fa49-link-target-type-restriction.scenario.json --out .tmp/etn-f8f8fa49/out",
  "timeout": 60000,
  "steps": [
    {
      "name": "onboarding-visible",
      "waitFor": "document.querySelector(\"input[placeholder^='http']\") !== null",
      "timeout": 20000
    },
    {
      "name": "fill-server-url",
      "click": "input[placeholder^='http']"
    },
    {
      "name": "server-url-typed",
      "text": "{{serverUrl}}"
    },
    {
      "name": "fill-api-key",
      "click": "input[type=password]"
    },
    {
      "name": "api-key-typed",
      "text": "{{apiKey}}"
    },
    {
      "name": "connect",
      "click": ".onboarding-card .ui-btn--primary"
    },
    {
      "name": "networks-visible",
      "waitFor": "document.querySelectorAll('.network-item').length > 0",
      "timeout": 20000
    },
    {
      "name": "seed-ontology-and-thoughts",
      "probe": "(() => { const N='{{networkId}}', H='{{homeId}}'; const et=window.etn; return (async () => { const person=await et.types.createThoughtType(N,{name:'Персона'}); const org=await et.types.createThoughtType(N,{name:'Организация'}); const prop=await et.propertyRegistry.create(N,{name:'Место работы',value_type:'link',name_forward:'Место работы',name_reverse:'Сотрудники'}); await et.types.createTypeProperty(N,'thought_type',person.id,{mode:'attach',property_id:prop.id,required:false,position:0,side:'source'}); await et.types.createTypeProperty(N,'thought_type',org.id,{mode:'attach',property_id:prop.id,required:false,position:0,side:'target'}); const mk=async(title,type)=>{ const r=await et.thoughts.create(N,{title,type_id:type,create_link:{direction:'parent',target_thought_id:H}}); return r.id; }; const P1=await mk('Персона Иванов',person.id); const O1=await mk('Организация Ромашка',org.id); const U1=await mk('Внетиповая персона',null); const U2=await mk('Внетиповой сотрудник',null); const C1=await mk('Кандидат персона',person.id); const C2=await mk('Кандидат организация',org.id); const C3=await mk('Кандидат без типа',null); await et.properties.set(N,'thought',P1,'Место работы',[O1],'source'); await et.properties.set(N,'thought',O1,'Сотрудники',[P1],'target'); await et.properties.set(N,'thought',U1,'Место работы',[O1],'source'); await et.properties.set(N,'thought',U2,'Сотрудники',[P1],'target'); window.__lx={person:person.id,org:org.id,prop:prop.id,P1,O1,U1,U2,C1,C2,C3}; return 'ok'; })(); })()",
      "expect": "ok"
    },
    {
      "name": "open-network",
      "click": ".networks-list .network-item"
    },
    {
      "name": "seeded-clouds",
      "waitFor": "(() => { const b=window.__lx; return b !== undefined && [b.P1,b.O1,b.U1,b.U2].every((id)=>document.querySelector('.cloud[data-id=\"'+id+'\"]') !== null); })()",
      "timeout": 30000
