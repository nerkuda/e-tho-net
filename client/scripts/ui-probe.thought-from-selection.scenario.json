{
  "name": "thought-from-selection",
  "description": "Ключевые сценарии задачи 785c7fac (T1 тех.проекта ac212c41, 0.12.2): «Создать мысль из выделенного» для одиночного выделения вне списков/заголовков открывает существующий диалог поиска/создания с предзаполнением. S1 (805f0596): короткое выделение → мысль без тела + ссылка [[#id]] на месте. S2 (007a81ea): длинное (с переносом) → заголовок из первой строки, тело — остаток, трансклюзия на месте. S4 (b2e3ca0b, уточнение визуальной проверки): ДЛИННОЕ выделение + существующая — литерально совпавшая часть заменяется ссылкой, при отсутствии совпадения ссылка встаёт в начало, текст не меняется (S4a/S4b); КОРОТКОЕ выделение + существующая — выделение целиком заменяется ссылкой с ПОДПИСЬЮ [[#id|текст]] (S4c), при совпадении с названием цели — [[#id]] без подписи (S4d). Отказ — текст не меняется. Данные: постоянный комментарий сид-мысли перезаписывается шагами (window.etn). Проверки — по сохранённому телу в БД (DOM скрытого окна троттлится rAF, грабли 03e33360). Запуск: node client/scripts/ui-probe-stand.mjs --scenario client/scripts/ui-probe.thought-from-selection.scenario.json. Без скриншотов.",
  "timeout": 60000,
  "steps": [
    {
      "name": "onboarding-visible",
      "waitFor": "document.querySelector(\"input[placeholder^='http']\") !== null"
    },
    { "name": "fill-server-url", "click": "input[placeholder^='http']" },
    { "name": "server-url-typed", "text": "{{serverUrl}}" },
    { "name": "fill-api-key", "click": "input[type=password]" },
    { "name": "api-key-typed", "text": "{{apiKey}}" },
    { "name": "connect", "click": ".onboarding-card .ui-btn--primary" },
    {
      "name": "networks-visible",
      "waitFor": "document.querySelectorAll('.network-item').length > 0"
    },
    { "name": "open-network", "click": ".networks-list .network-item" },
    {
      "name": "seeded-cloud-visible",
      "waitFor": "document.querySelector('[data-id=\"{{thoughtId}}\"]') !== null"
    },

    {
      "name": "define-helpers",
      "eval": "(() => { const nid = '{{networkId}}', seed = '{{thoughtId}}'; window.__st = { knownId: null, setBody: async (md) => { const cs = await window.etn.comments.list(nid, 'thought', seed); const p = cs.find((c) => c.kind === 'permanent'); if (p) { await window.etn.comments.update(nid, p.id, { body_md: md }, p.version); } else { await window.etn.comments.create(nid, 'thought', seed, { kind: 'permanent', body_md: md }); } return true; }, focus: (id) => { const el = document.querySelector('[data-id=\"' + id + '\"].cloud'); if (!el) return false; el.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true })); return true; }, openMenu: () => { const c = document.querySelector('.md-field--editing .cm-content'); if (!c) throw new Error('нет поля в правке'); const r = c.getBoundingClientRect(); c.dispatchEvent(new MouseEvent('contextmenu', { bubbles: true, cancelable: true, clientX: r.left + 10, clientY: r.top + 10 })); return true; }, menu: (label) => { const rows = Array.from(document.querySelectorAll('.menu-item')); const row = rows.find((e) => (e.textContent || '').includes(label)); if (!row) throw new Error('нет пункта: ' + label); row.dispatchEvent(new MouseEvent('mousedown', { bubbles: true, cancelable: true })); row.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true })); return true; }, body: async () => { const cs = await window.etn.comments.list(nid, 'thought', seed); const p = cs.find((c) => c.kind === 'permanent'); return p ? p.body_md : ''; }, clearInput: () => { const t = document.querySelector('.dialog-body textarea[placeholder^=\"Введите название\"]'); if (!t) throw new Error('нет поля диалога'); t.focus(); return true; }, pickCand: (title) => { const row = Array.from(document.querySelectorAll('.add-candidates .type-combo-item')).find((e) => (e.textContent || '').includes(title)); if (!row) throw new Error('нет кандидата: ' + title); row.dispatchEvent(new MouseEvent('mousedown', { bubbles: true, cancelable: true })); row.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true })); return true; }, find: async (title) => { const r = await window.etn.thoughts.search(nid, { q: title, scope: 'names', limit: 20 }); const h = (r.by_names || []).find((x) => x.title === title); if (!h) return null; const cs = await window.etn.comments.list(nid, 'thought', h.thought_id); const p = cs.find((c) => c.kind === 'permanent'); return { id: h.thought_id, title: h.title, body: p ? p.body_md : null }; }, children: async () => { const r = await window.etn.thoughts.neighbors(nid, seed, 'children', 100, 0); const list = Array.isArray(r) ? r : (r && (r.items || r.data)) || []; return list.map((x) => x.title || (x.thought && x.thought.title) || ''); } }; return true; })()"
    },

    {
      "name": "seed-known",
      "eval": "(async () => { const t = await window.etn.thoughts.create('{{networkId}}', { title: 'Известная мысль стенда' }); window.__st.knownId = t.id; return t.id; })()"
    },

