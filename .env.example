# ETN server configuration (example). Copy to `.env` and adjust.

# Directory where _system.db and networks/ are stored.
ETN_DATA_DIR=./etn_data

# Listen host/port.
ETN_HOST=0.0.0.0
ETN_PORT=4321

# TLS (recommended for non-localhost deployments).
# ETN_TLS_CERT=./certs/fullchain.pem
# ETN_TLS_KEY=./certs/privkey.pem

# Log level: trace|debug|info|warn|error
ETN_LOG_LEVEL=info
