      "transport": {
        "type": "stdio"
      }
    },
    {
      "registryType": "oci",
      "identifier": "docker.io/nerkuda/etn-mcp:v0.16.2",
      "version": "0.16.2",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
