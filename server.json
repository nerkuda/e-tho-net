{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.nerkuda/e-tho-net",
  "description": "Self-hosted graph-of-thoughts knowledge base with MCP tools for AI agents.",
  "version": "0.16.2",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "etn-mcp",
      "version": "0.16.2",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ETN_DATA_DIR",
          "description": "ETN data directory. When started via the etn-mcp wrapper, defaults to a personal per-user directory.",
          "isRequired": false,
          "format": "string",
          "isSecret": false
        },
        {
          "name": "ETN_API_KEY",
          "description": "API key of an existing ETN server to attach to.",
          "isRequired": false,
          "format": "string",
          "isSecret": true
        }
      ]
    },
    {
