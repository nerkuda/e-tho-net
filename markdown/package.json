{
  "name": "@etn/markdown",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "ETN — единый XSS-безопасный markdown-рендерер (сервер + клиент): wiki-ссылки, размеры картинок, подсветка кода",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/**/*.test.ts"
  },
  "dependencies": {
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "tsx": "^4.23.12",
    "typescript": "^5.5.4"
  }
}
