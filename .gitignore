# Dependencies
node_modules/

# Build artifacts
dist/
build/
out/
release/
*.tsbuildinfo

# Исходные ресурсы упаковки electron-builder (client/build) — версионируются
# (ошибка 5d0f698b: правило `build/` молча съедало новые ассеты упаковки).
# Генерируемый notices-файл остаётся игнорируемым.
!client/build/
client/build/THIRD-PARTY-NOTICES.txt

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# SQLite runtime data (never commit databases)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-journal
etn_data/
data/
var/

# Env / secrets
.env
.env.local
.env.*.local

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~

# Agent workspace (ZCode). В .zcode лежат личные данные (API-ключи в
# config.json, планы сессий) — коммитится только .zcode/skills/ (скиллы).
# Профили субагентов (.zcode/agents) НЕ версионируются: не должны пушиться
# на публичный github; разделить файлы по remote git не может (грабли).
.zcode/*
!.zcode/skills/
!.zcode/skills/**

# OS
.DS_Store
Thumbs.db
desktop.ini

# Test / coverage
coverage/
.nyc_output/

# Local scratch / migration test beds
.tmp/
tmp/
# Артефакты живых прогонов ui-probe (каталог `--out`, PNG-доказательства)
ui-probe-out/

# Локальные скрипты выгрузки документации из ETN (ключи в .env) — не поставка
tools/docs-export/
