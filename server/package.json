{
  "name": "@etn/server",
  "version": "0.5.5",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "etn": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=../.env --watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-timeout=120000 --import tsx tests/**/*.test.ts"
  },
  "dependencies": {
    "@etn/markdown": "*",
    "@fastify/cors": "^9.0.1",
    "@fastify/websocket": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "archiver": "^7.0.1",
    "better-sqlite3": "11.1.2",
    "fastify": "^4.27.0",
    "pino": "^9.14.0",
    "undici": "^6.19.8",
    "ws": "^8.21.3",
    "yauzl": "^3.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.7.0",
    "typescript": "^5.5.4"
  }
}
